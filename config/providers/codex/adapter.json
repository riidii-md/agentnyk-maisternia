{
  "schema_version": 1,
  "id": "codex",
  "display_name": "Codex CLI",
  "aliases": [],
  "renderer": {
    "config_roots": [
      {
        "path": ".codex",
        "purpose": "User settings, instructions, prompts, skills, hooks, plugins, profiles, and runtime data",
        "ownership": "mixed",
        "required": false
      }
    ],
    "resource_kinds": [
      "commands",
      "hooks",
      "instructions",
      "mcp",
      "plugins",
      "profiles",
      "settings",
      "skills"
    ]
  },
  "inspector": {
    "executables": [
      {
        "name": "codex",
        "version_args": ["--version"],
        "version_pattern": "^codex-cli [0-9]"
      }
    ],
    "native_doctor": {
      "args": ["doctor", "--json"],
      "safe": true,
      "note": "Produces a local diagnostic report without dispatching a model run; maisternia still keeps native doctor execution explicit."
    }
  },
  "runner": {
    "supported": true,
    "headless": true,
    "safe_headless": true,
    "authorities": [
      "artifact_write",
      "read_only",
      "workspace_write"
    ],
    "output_formats": [
      "jsonl",
      "text"
    ]
  },
  "parser": {
    "formats": [
      "jsonl",
      "text"
    ],
    "structured_output": true
  },
  "capabilities": [
    "config.commands",
    "config.hooks",
    "config.instructions",
    "config.mcp",
    "config.plugins",
    "config.profiles",
    "config.settings",
    "config.skills",
    "filesystem.read",
    "filesystem.workspace_write",
    "output.structured",
    "repository.read",
    "repository.test",
    "runner.headless",
    "runner.safe_headless",
    "safety.tool_guard",
    "session.resume",
    "subagent.spawn",
    "workflow.artifact_write",
    "workflow.goal",
    "workflow.stop_continue",
    "worktree.isolation"
  ]
}
