{
  "schema_version": 1,
  "id": "scored-experiment",
  "name": "Scored Experiment",
  "description": "Provider-native baseline, focused change, scoring, evidence, and bounded continuation loop.",
  "pipelines": [
    {
      "id": "improve",
      "name": "Improve",
      "entry_phases": ["baseline"],
      "phases": [
        "baseline", "experiment", "score", "record", "decide", "review"
      ],
      "edges": [
        {"from": "baseline", "to": "experiment"},
        {"from": "experiment", "to": "score"},
        {"from": "score", "to": "record"},
        {"from": "record", "to": "decide"},
        {"from": "decide", "to": "review", "condition": "target or limit"},
        {"from": "decide", "to": "experiment", "condition": "continue", "loop": true}
      ]
    }
  ],
  "contents": {
    "mcp_refs": [],
    "commands": ["work-experiment", "work-routing-preferences"],
    "prompts": [],
    "skills": ["work-routing-skill", "work-routing-runners"],
    "hooks": [],
    "settings": ["work-routing-profile-schema"]
  },
  "targets": ["codex", "claude", "antigravity", "hermes"]
}
