{
  "schema_version": 1,
  "id": "harness-profile",
  "name": "Harness Profile",
  "description": "Read-only inventory and cost baseline for active instructions, commands, prompts, skills, MCP, hooks, settings, plugins, and model routing.",
  "pipelines": [
    {
      "id": "profile",
      "name": "Profile",
      "entry_phases": ["inventory"],
      "phases": ["inventory", "measure", "report"],
      "edges": [
        {"from": "inventory", "to": "measure"},
        {"from": "measure", "to": "report"}
      ]
    }
  ],
  "contents": {
    "mcp_refs": [],
    "commands": ["work-profile", "work-routing-preferences"],
    "prompts": [],
    "skills": [
      "session-retrospective-skill", "work-routing-skill",
      "work-routing-runners"
    ],
    "hooks": [],
    "settings": [
      "retrospective-policy", "retrospective-record-schema",
      "work-routing-profile-schema"
    ]
  },
  "targets": ["codex", "claude", "antigravity", "hermes"]
}
