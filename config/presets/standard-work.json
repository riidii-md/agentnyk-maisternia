{
  "schema_version": 1,
  "id": "standard-work",
  "name": "Standard Work",
  "description": "Provider-neutral guided delivery with human collaboration after analysis, research, direction, and planning; optional AI review; explicit human decisions; implementation verification; and mandatory change review.",
  "tags": ["role/software-engineer", "workflow/delivery"],
  "pipelines": [
    {
      "id": "delivery",
      "name": "Delivery",
      "entry_phases": ["brief", "scout"],
      "phases": [
        "brief", "scout", "analyze", "analyze-collaboration",
        "research", "research-collaboration", "direction", "direction-collaboration",
        "direction-review", "direction-decision", "plan", "prove", "plan-collaboration",
        "plan-review", "decide", "ready", "handoff", "run", "verify",
        "review", "change-review", "pr", "session-analysis"
      ],
      "edges": [
        {"from": "brief", "to": "scout"},
        {"from": "scout", "to": "analyze"},
        {"from": "analyze", "to": "scout", "condition": "boundary evidence gap", "loop": true},
        {"from": "analyze", "to": "analyze-collaboration"},
        {"from": "analyze-collaboration", "to": "analyze-collaboration", "condition": "discussion continues", "loop": true},
        {"from": "analyze-collaboration", "to": "analyze", "condition": "scope changes", "loop": true},
        {"from": "analyze-collaboration", "to": "scout", "condition": "boundary evidence gap", "loop": true},
        {"from": "analyze-collaboration", "to": "research", "condition": "human continues; research needed or requested"},
        {"from": "analyze-collaboration", "to": "direction", "condition": "human continues; direction required and evidence sufficient"},
        {"from": "analyze-collaboration", "to": "plan", "condition": "human continues; direction not required and evidence sufficient"},
        {"from": "research", "to": "research-collaboration"},
        {"from": "research-collaboration", "to": "research-collaboration", "condition": "discussion continues", "loop": true},
        {"from": "research-collaboration", "to": "research", "condition": "more research requested or evidence gap", "loop": true},
        {"from": "research-collaboration", "to": "analyze", "condition": "scope changes", "loop": true},
        {"from": "research-collaboration", "to": "direction", "condition": "human continues; direction required and evidence sufficient"},
        {"from": "research-collaboration", "to": "plan", "condition": "human continues; direction not required and evidence sufficient"},
        {"from": "direction", "to": "direction-collaboration"},
        {"from": "direction", "to": "scout", "condition": "boundary evidence gap", "loop": true},
        {"from": "direction", "to": "research", "condition": "evidence gap", "loop": true},
        {"from": "direction-collaboration", "to": "direction-collaboration", "condition": "discussion continues", "loop": true},
        {"from": "direction-collaboration", "to": "direction", "condition": "changes requested", "loop": true},
        {"from": "direction-collaboration", "to": "analyze", "condition": "scope changes", "loop": true},
        {"from": "direction-collaboration", "to": "research", "condition": "more research requested or evidence gap", "loop": true},
        {"from": "direction-collaboration", "to": "direction-review", "condition": "human continues; AI review selected"},
        {"from": "direction-collaboration", "to": "direction-decision", "condition": "human continues; AI review skipped"},
        {"from": "direction-review", "to": "direction-decision", "condition": "pass"},
        {"from": "direction-review", "to": "direction", "condition": "changes", "loop": true},
        {"from": "direction-review", "to": "research", "condition": "evidence gap", "loop": true},
        {"from": "direction-decision", "to": "plan", "condition": "approved"},
        {"from": "direction-decision", "to": "direction", "condition": "changes requested", "loop": true},
        {"from": "direction-decision", "to": "analyze", "condition": "rejected and reshape requested", "loop": true},
        {"from": "direction-decision", "to": "direction", "condition": "stale", "loop": true},
        {"from": "plan", "to": "prove", "condition": "expanded proof needed"},
        {"from": "plan", "to": "plan-collaboration", "condition": "proof gate satisfied"},
        {"from": "prove", "to": "plan-collaboration"},
        {"from": "plan-collaboration", "to": "plan-collaboration", "condition": "discussion continues", "loop": true},
        {"from": "plan-collaboration", "to": "plan", "condition": "changes requested", "loop": true},
        {"from": "plan-collaboration", "to": "analyze", "condition": "scope changes", "loop": true},
        {"from": "plan-collaboration", "to": "research", "condition": "more research requested or evidence gap", "loop": true},
        {"from": "plan-collaboration", "to": "plan-review", "condition": "human continues; AI review selected"},
        {"from": "plan-collaboration", "to": "decide", "condition": "human continues; AI review skipped"},
        {"from": "plan-review", "to": "decide", "condition": "pass"},
        {"from": "plan-review", "to": "plan", "condition": "changes", "loop": true},
        {"from": "decide", "to": "ready", "condition": "approved"},
        {"from": "decide", "to": "plan", "condition": "changes", "loop": true},
        {"from": "decide", "to": "analyze", "condition": "rejected and reshape requested", "loop": true},
        {"from": "ready", "to": "handoff", "condition": "new executor"},
        {"from": "ready", "to": "run", "condition": "continuous session"},
        {"from": "ready", "to": "plan", "condition": "not ready", "loop": true},
        {"from": "handoff", "to": "run"},
        {"from": "run", "to": "verify"},
        {"from": "verify", "to": "review", "condition": "pass"},
        {"from": "verify", "to": "analyze", "condition": "failed", "loop": true},
        {"from": "review", "to": "run", "condition": "changes", "loop": true},
        {"from": "review", "to": "change-review", "condition": "pass"},
        {"from": "change-review", "to": "pr", "condition": "approved and publication requested"},
        {"from": "change-review", "to": "run", "condition": "changes requested", "loop": true},
        {"from": "change-review", "to": "analyze", "condition": "rejected and reshape requested", "loop": true},
        {"from": "change-review", "to": "change-review", "condition": "stale", "loop": true},
        {"from": "pr", "to": "session-analysis", "condition": "PR created and user accepts analysis"}
      ]
    },
    {
      "id": "pr-review",
      "name": "Pull Request Review",
      "entry_phases": ["resolve-destination"],
      "phases": [
        "resolve-destination", "sync-pr-context", "select-review-suite",
        "run-reviews", "synthesize-feedback", "implementation-approval",
        "internal-repair", "verify-repair", "internal-report", "pr-feedback"
      ],
      "edges": [
        {"from": "resolve-destination", "to": "sync-pr-context", "condition": "destination selected"},
        {"from": "sync-pr-context", "to": "select-review-suite"},
        {"from": "select-review-suite", "to": "run-reviews"},
        {"from": "run-reviews", "to": "synthesize-feedback"},
        {"from": "synthesize-feedback", "to": "implementation-approval", "condition": "explicitly authorized internal repair review passes"},
        {"from": "synthesize-feedback", "to": "internal-report", "condition": "internal report-only review completes"},
        {"from": "synthesize-feedback", "to": "pr-feedback", "condition": "PR publication review passes"},
        {"from": "implementation-approval", "to": "internal-repair", "condition": "changes requested"},
        {"from": "implementation-approval", "to": "implementation-approval", "condition": "decision stale", "loop": true},
        {"from": "internal-repair", "to": "verify-repair"},
        {"from": "verify-repair", "to": "internal-repair", "condition": "verification failed", "loop": true},
        {"from": "verify-repair", "to": "run-reviews", "condition": "verification passes", "loop": true},
        {"from": "pr-feedback", "to": "sync-pr-context", "condition": "head, checks, or comments stale before publication", "loop": true},
        {"from": "pr-feedback", "to": "sync-pr-context", "condition": "post-publication reconciliation detects drift", "loop": true}
      ]
    }
  ],
  "contents": {
    "mcp_refs": [],
    "commands": [
      "work-start", "work-start-pr-review", "work-conductor", "work-brief", "work-scout", "work-analyze",
      "work-research", "work-collaborate", "work-grill", "work-direction", "work-decide", "work-ready", "work-plan", "work-prove",
      "work-plan-review", "work-handoff", "work-run", "work-run-simplify", "work-verify",
      "work-review", "work-review-simplify", "work-test-review", "work-human-review", "work-pr", "work-session-analysis", "work-showcase", "work-cleanup",
      "work-routing-preferences"
    ],
    "prompts": [],
    "skills": [
      "change-narrative-skill",
      "change-narrative-graph-contract",
      "multi-lens-review-skill",
      "readable-output-skill",
      "readable-output-project-naming",
      "readable-output-space-routing",
      "decision-capture-skill",
      "session-retrospective-skill",
      "work-routing-skill",
      "work-routing-runners",
      "readable-output-document-wording",
      "readable-output-task-context"
    ],
    "hooks": [],
    "settings": [
      "design-graph-policy", "review-policy", "review-report-schema", "work-routing-profile-schema",
      "approval-policy",
      "git-workflow-approvals-codex-rules",
      "git-workflow-approvals-claude-permissions",
      "retrospective-policy", "retrospective-record-schema", "retrospective-source-schema",
      "routine-development-approvals-codex-rules",
      "routine-development-approvals-claude-permissions"
    ]
  },
  "targets": ["codex", "claude", "antigravity", "hermes"]
}
