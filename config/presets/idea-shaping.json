{
  "schema_version": 1,
  "id": "idea-shaping",
  "name": "Idea Shaping",
  "description": "Evidence-led shaping with human collaboration after analysis, research, direction, and planning; focused grill questions and optional human drafts; conditional architecture; and optional AI review.",
  "tags": ["role/software-engineer", "workflow/discovery"],
  "pipelines": [
    {
      "id": "shape",
      "name": "Shape",
      "entry_phases": ["intake"],
      "phases": [
        "intake", "scout", "analyze", "analyze-collaboration",
        "research", "research-collaboration", "brainstorm", "challenge", "decide",
        "direction", "direction-collaboration", "direction-review", "direction-decision",
        "plan", "plan-collaboration", "plan-review", "final"
      ],
      "edges": [
        {"from": "intake", "to": "scout", "condition": "system context linked"},
        {"from": "intake", "to": "analyze", "condition": "no linked system to scout"},
        {"from": "scout", "to": "analyze"},
        {"from": "analyze", "to": "scout", "condition": "boundary evidence gap", "loop": true},
        {"from": "analyze", "to": "analyze-collaboration"},
        {"from": "analyze-collaboration", "to": "analyze-collaboration", "condition": "discussion continues", "loop": true},
        {"from": "analyze-collaboration", "to": "analyze", "condition": "scope changes", "loop": true},
        {"from": "analyze-collaboration", "to": "scout", "condition": "boundary evidence gap", "loop": true},
        {"from": "analyze-collaboration", "to": "research", "condition": "human continues; research needed or requested"},
        {"from": "analyze-collaboration", "to": "brainstorm", "condition": "human continues; ready to compare options"},
        {"from": "research", "to": "research-collaboration"},
        {"from": "research-collaboration", "to": "research-collaboration", "condition": "discussion continues", "loop": true},
        {"from": "research-collaboration", "to": "research", "condition": "more research requested or evidence gap", "loop": true},
        {"from": "research-collaboration", "to": "analyze", "condition": "scope changes", "loop": true},
        {"from": "research-collaboration", "to": "brainstorm", "condition": "human continues; ready to compare options"},
        {"from": "brainstorm", "to": "challenge"},
        {"from": "challenge", "to": "direction", "condition": "direction required and viable candidates"},
        {"from": "challenge", "to": "decide", "condition": "direction not required and viable candidate"},
        {"from": "decide", "to": "plan", "condition": "human option choice recorded"},
        {"from": "challenge", "to": "brainstorm", "condition": "weak options", "loop": true},
        {"from": "direction", "to": "direction-collaboration"},
        {"from": "direction", "to": "scout", "condition": "boundary evidence gap", "loop": true},
        {"from": "direction", "to": "research", "condition": "evidence gap", "loop": true},
        {"from": "direction-collaboration", "to": "direction-collaboration", "condition": "discussion continues", "loop": true},
        {"from": "direction-collaboration", "to": "direction", "condition": "changes requested", "loop": true},
        {"from": "direction-collaboration", "to": "analyze", "condition": "scope changes", "loop": true},
        {"from": "direction-collaboration", "to": "research", "condition": "more research requested or evidence gap", "loop": true},
        {"from": "direction-collaboration", "to": "direction-review", "condition": "human continues; AI review selected"},
        {"from": "direction-collaboration", "to": "direction-decision", "condition": "human continues; AI review skipped"},
        {"from": "direction-review", "to": "direction-decision", "condition": "pass"},
        {"from": "direction-review", "to": "direction", "condition": "changes", "loop": true},
        {"from": "direction-review", "to": "research", "condition": "evidence gap", "loop": true},
        {"from": "direction-decision", "to": "plan", "condition": "approved"},
        {"from": "direction-decision", "to": "direction", "condition": "changes requested", "loop": true},
        {"from": "direction-decision", "to": "analyze", "condition": "rejected and reshape requested", "loop": true},
        {"from": "direction-decision", "to": "direction", "condition": "stale", "loop": true},
        {"from": "plan", "to": "plan-collaboration"},
        {"from": "plan-collaboration", "to": "plan-collaboration", "condition": "discussion continues", "loop": true},
        {"from": "plan-collaboration", "to": "plan", "condition": "changes requested", "loop": true},
        {"from": "plan-collaboration", "to": "analyze", "condition": "scope changes", "loop": true},
        {"from": "plan-collaboration", "to": "research", "condition": "more research requested or evidence gap", "loop": true},
        {"from": "plan-collaboration", "to": "plan-review", "condition": "human continues; AI review selected"},
        {"from": "plan-collaboration", "to": "final", "condition": "human continues; AI review skipped"},
        {"from": "plan-review", "to": "final", "condition": "pass"},
        {"from": "plan-review", "to": "plan", "condition": "changes", "loop": true},
        {"from": "challenge", "to": "analyze-collaboration", "condition": "missing constraint", "loop": true}
      ]
    }
  ],
  "contents": {
    "mcp_refs": [],
    "commands": [
      "work-shape", "work-source", "work-scout", "work-analyze", "work-collaborate", "work-grill", "work-brainstorm",
      "work-question", "work-research", "work-direction", "work-plan-review", "work-decide", "work-plan",
      "work-routing-preferences"
    ],
    "prompts": [],
    "skills": [
      "readable-output-skill",
      "readable-output-project-naming",
      "readable-output-space-routing",
      "work-routing-skill",
      "work-routing-runners",
      "readable-output-document-wording",
      "readable-output-task-context"
    ],
    "hooks": [],
    "settings": [
      "design-graph-policy", "review-policy", "review-report-schema",
      "work-routing-profile-schema"
    ]
  },
  "targets": ["codex", "claude", "antigravity", "hermes"]
}
