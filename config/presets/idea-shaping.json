{
  "schema_version": 1,
  "id": "idea-shaping",
  "name": "Idea Shaping",
  "description": "Continuous source intake, research, focused human questions, option generation, challenge, decision, and planning.",
  "tags": ["role/software-engineer", "workflow/discovery"],
  "pipelines": [
    {
      "id": "shape",
      "name": "Shape",
      "entry_phases": ["intake"],
      "phases": [
        "intake", "research", "grill", "brainstorm", "challenge", "decide",
        "plan", "final"
      ],
      "edges": [
        {"from": "intake", "to": "research"},
        {"from": "research", "to": "grill"},
        {"from": "grill", "to": "brainstorm"},
        {"from": "brainstorm", "to": "challenge"},
        {"from": "challenge", "to": "decide"},
        {"from": "decide", "to": "plan"},
        {"from": "plan", "to": "final", "condition": "human finalization"},
        {"from": "grill", "to": "research", "condition": "evidence gap", "loop": true},
        {"from": "challenge", "to": "brainstorm", "condition": "weak options", "loop": true},
        {"from": "challenge", "to": "grill", "condition": "missing constraint", "loop": true}
      ]
    }
  ],
  "contents": {
    "mcp_refs": [],
    "commands": [
      "work-shape", "work-source", "work-grill", "work-brainstorm",
      "work-research", "work-decide", "work-plan",
      "work-routing-preferences"
    ],
    "prompts": [],
    "skills": ["work-routing-skill", "work-routing-runners"],
    "hooks": [],
    "settings": ["work-routing-profile-schema"]
  },
  "targets": ["codex", "claude", "antigravity", "hermes"]
}
