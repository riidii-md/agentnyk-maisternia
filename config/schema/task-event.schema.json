{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagi-labs/agentctl/config/schema/task-event.schema.json",
  "title": "agentctl task history event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "task_id", "type", "occurred_at", "actor", "source_event_id", "details"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string"},
    "task_id": {"type": "string"},
    "type": {"enum": ["trigger.ingested"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"const": "agentctl"},
    "source_event_id": {"type": "string"},
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "trigger_type"],
      "properties": {
        "source": {"type": "string"},
        "trigger_type": {"type": "string"}
      }
    }
  }
}
