{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riidii-md/agentnyk-maisternia/config/schema/review-report.schema.json",
  "title": "AgentnykMaisternia multi-lens review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "mode",
    "target",
    "base_ref",
    "execution",
    "lenses",
    "findings",
    "applied_fixes",
    "checks",
    "summary",
    "gate_status"
  ],
  "properties": {
    "schema_version": {"const": 5},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,128}$"},
    "mode": {"enum": ["direction", "plan", "plan-delta", "implementation"]},
    "disposition": {"enum": ["repair", "report-only"]},
    "profile": {"enum": ["standard", "maintainability"]},
    "scope": {"enum": ["full", "tests"]},
    "test_review_mode": {"enum": ["review", "authoring", "audit", "campaign"]},
    "target": {"type": "string", "minLength": 1, "maxLength": 4096},
    "base_ref": {"type": ["string", "null"], "maxLength": 256},
    "execution": {"$ref": "#/$defs/execution"},
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lens"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "applied_fixes": {
      "type": "array",
      "items": {"$ref": "#/$defs/appliedFix"}
    },
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "test_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/testEvidence"}
    },
    "test_authoring_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/testAuthoringGate"}
    },
    "test_audit_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/testAuditCandidate"}
    },
    "test_campaign": {"$ref": "#/$defs/testCampaign"},
    "maintainability_inspections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/maintainabilityInspection"},
      "allOf": [
        {
          "contains": {
            "properties": {"id": {"const": "alternative-comparison"}},
            "required": ["id"]
          }
        },
        {
          "contains": {
            "properties": {"id": {"const": "contract-coherence"}},
            "required": ["id"]
          }
        },
        {
          "contains": {
            "properties": {"id": {"const": "error-and-validation-flow"}},
            "required": ["id"]
          }
        },
        {
          "contains": {
            "properties": {"id": {"const": "runtime-invariant-placement"}},
            "required": ["id"]
          }
        }
      ]
    },
    "analysis_tool_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/analysisToolEvidence"},
      "allOf": [
        {
          "contains": {
            "properties": {"producer": {"const": "jscpd"}},
            "required": ["producer"]
          }
        },
        {
          "contains": {
            "properties": {"producer": {"const": "gitnexus"}},
            "required": ["producer"]
          }
        }
      ]
    },
    "maintainability_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/maintainabilityCandidate"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "gate_status": {"enum": ["pass", "fail", "blocked", "degraded"]}
  },
  "$defs": {
    "provider": {
      "enum": ["codex", "claude", "antigravity", "hermes", "current", "unknown"]
    },
    "severity": {
      "enum": ["critical", "high", "medium", "low"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "excerpt"],
      "properties": {
        "kind": {
          "enum": ["file-line", "verbatim-quote", "test", "command", "authoritative-document"]
        },
        "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
        "excerpt": {"type": ["string", "null"], "maxLength": 4096}
      }
    },
    "analysisCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzed", "excluded", "unresolved", "failed"],
      "properties": {
        "analyzed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "unresolved": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "failed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "analysisToolEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "requirement",
        "version",
        "configuration",
        "repository_snapshot",
        "status",
        "coverage",
        "artifact"
      ],
      "properties": {
        "producer": {"enum": ["jscpd", "gitnexus"]},
        "requirement": {"enum": ["disabled", "advisory", "required"]},
        "version": {"type": ["string", "null"], "maxLength": 256},
        "configuration": {"type": "string", "minLength": 1, "maxLength": 4096},
        "repository_snapshot": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"enum": ["complete", "partial", "unavailable", "failed", "stale"]},
        "coverage": {"$ref": "#/$defs/analysisCoverage"},
        "artifact": {"type": ["string", "null"], "maxLength": 2048}
      }
    },
    "maintainabilityLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 2048},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "maintainabilityRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target", "depth", "status", "evidence"],
      "properties": {
        "kind": {
          "enum": [
            "caller", "callee", "import", "dependency", "inheritance",
            "implementation", "process", "route", "test",
            "related-implementation", "impact", "other"
          ]
        },
        "source": {"type": "string", "minLength": 1, "maxLength": 1024},
        "target": {"type": "string", "minLength": 1, "maxLength": 1024},
        "depth": {"type": "integer", "minimum": 0, "maximum": 16},
        "status": {"enum": ["direct", "transitive", "partial", "stale", "ambiguous"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "maintainabilityJudgments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["similarity", "repeated_responsibility", "safe_to_share"],
      "properties": {
        "similarity": {"enum": ["exact", "related", "weak", "uncertain", "not-applicable"]},
        "repeated_responsibility": {"enum": ["yes", "no", "uncertain", "not-applicable"]},
        "safe_to_share": {"enum": ["yes", "no", "uncertain", "not-applicable"]}
      }
    },
    "maintainabilityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "locations",
        "changed_code_intersection",
        "signals",
        "relationships",
        "counterevidence",
        "missing_evidence",
        "judgments",
        "treatment",
        "finding_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^MC-[0-9]+$"},
        "class": {"enum": ["duplication", "similarity", "complexity", "dead-code", "structural"]},
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/maintainabilityLocation"}
        },
        "changed_code_intersection": {"type": "boolean"},
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "relationships": {
          "type": "array",
          "items": {"$ref": "#/$defs/maintainabilityRelationship"}
        },
        "counterevidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "judgments": {"$ref": "#/$defs/maintainabilityJudgments"},
        "treatment": {"enum": ["reuse", "delete", "extract", "shrink", "retain", "investigate"]},
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"}
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "provider", "runtime", "assignments", "wave", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,128}$"},
        "role": {"enum": ["reviewer", "verifier"]},
        "provider": {"$ref": "#/$defs/provider"},
        "runtime": {"enum": ["native-subagent", "external-harness", "coordinator-degraded"]},
        "assignments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "wave": {"type": "integer", "minimum": 1},
        "status": {"enum": ["complete", "failed", "unavailable"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "coordinator",
        "workers",
        "waves",
        "minimum_independent_reviewers_met",
        "fallback_reason"
      ],
      "properties": {
        "mode": {"enum": ["multi-agent", "multi-agent-incomplete", "degraded-sequential"]},
        "coordinator": {"type": "string", "minLength": 1, "maxLength": 256},
        "workers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/worker"}
        },
        "waves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,128}$"}
          }
        },
        "minimum_independent_reviewers_met": {"type": "boolean"},
        "fallback_reason": {"type": ["string", "null"], "maxLength": 4096}
      }
    },
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "reviewer", "worker_id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "provider": {"$ref": "#/$defs/provider"},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 256},
        "worker_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,128}$"},
        "status": {"enum": ["complete", "failed", "unavailable", "skipped"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "provider", "worker_id", "independent_from", "is_real", "grounded", "rationale", "evidence"],
      "properties": {
        "verifier": {"type": "string", "minLength": 1, "maxLength": 256},
        "provider": {"$ref": "#/$defs/provider"},
        "worker_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,128}$"},
        "independent_from": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,128}$"},
        "is_real": {"type": "boolean"},
        "grounded": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lens",
        "provider",
        "severity",
        "title",
        "claim",
        "impact",
        "evidence",
        "proposed_fix",
        "status",
        "verification"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"},
        "lens": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider": {"$ref": "#/$defs/provider"},
        "severity": {"$ref": "#/$defs/severity"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "claim": {"type": "string", "minLength": 1, "maxLength": 4096},
        "impact": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "simplification_kind": {
          "enum": ["delete", "reuse", "stdlib", "native", "dependency", "yagni", "shrink"]
        },
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MC-[0-9]+$"}
        },
        "proposed_fix": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"enum": ["confirmed", "refuted"]},
        "verification": {"$ref": "#/$defs/verification"}
      }
    },
    "appliedFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "paths", "reason"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"},
        "status": {"enum": ["applied", "blocked", "not-applicable"]},
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "reason": {"type": ["string", "null"], "maxLength": 4096}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "evidence"],
      "properties": {
        "command": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"enum": ["pass", "fail", "not-run", "unavailable"]},
        "evidence": {"type": ["string", "null"], "maxLength": 4096}
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_or_risk",
        "source",
        "test_level",
        "scenario",
        "oracle",
        "evidence",
        "distinct_value",
        "residual_risk",
        "status"
      ],
      "properties": {
        "contract_or_risk": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source": {"$ref": "#/$defs/evidence"},
        "test_level": {
          "enum": [
            "unit", "contract", "integration", "end-to-end", "fuzz",
            "property", "static", "manual", "other"
          ]
        },
        "scenario": {"type": "string", "minLength": 1, "maxLength": 4096},
        "oracle": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "distinct_value": {"type": "string", "minLength": 1, "maxLength": 4096},
        "residual_risk": {"type": ["string", "null"], "maxLength": 4096},
        "status": {"enum": ["covered", "partial", "missing", "accepted-risk"]},
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MC-[0-9]+$"}
        }
      }
    },
    "testAuthoringGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "contract",
        "credible_regression",
        "existing_coverage_gap",
        "owner_boundary",
        "production_seam",
        "regression_control",
        "status"
      ],
      "properties": {
        "test": {"type": "string", "minLength": 1, "maxLength": 4096},
        "contract": {"type": "string", "minLength": 1, "maxLength": 4096},
        "credible_regression": {"type": "string", "minLength": 1, "maxLength": 4096},
        "existing_coverage_gap": {"type": "string", "minLength": 1, "maxLength": 4096},
        "owner_boundary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "production_seam": {"type": ["string", "null"], "maxLength": 4096},
        "regression_control": {"type": ["string", "null"], "maxLength": 4096},
        "status": {"enum": ["pass", "fail", "blocked"]}
      }
    },
    "testAuditCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "disposition",
        "detected_failure",
        "primary_owner",
        "non_test_callers",
        "surviving_proof",
        "history",
        "unlocked_deletions",
        "risk",
        "validation"
      ],
      "properties": {
        "test": {"type": "string", "minLength": 1, "maxLength": 4096},
        "disposition": {"enum": ["retain", "fix", "consolidate", "delete"]},
        "detected_failure": {"type": "string", "minLength": 1, "maxLength": 4096},
        "primary_owner": {"type": "string", "minLength": 1, "maxLength": 4096},
        "non_test_callers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "surviving_proof": {"type": ["string", "null"], "maxLength": 4096},
        "history": {"type": "string", "minLength": 1, "maxLength": 4096},
        "unlocked_deletions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "risk": {"type": "string", "minLength": 1, "maxLength": 4096},
        "validation": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "testCampaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subsystem",
        "baseline_ref",
        "baseline_results",
        "lanes",
        "preservation_review",
        "product_defects",
        "line_counts"
      ],
      "properties": {
        "subsystem": {"type": "string", "minLength": 1, "maxLength": 4096},
        "baseline_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "baseline_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/check"}
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "preservation_review": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "product_defects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "line_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["production_before", "production_after", "test_support_before", "test_support_after"],
          "properties": {
            "production_before": {"type": "integer", "minimum": 0},
            "production_after": {"type": "integer", "minimum": 0},
            "test_support_before": {"type": "integer", "minimum": 0},
            "test_support_after": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "maintainabilityInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lenses",
        "status",
        "evidence",
        "rationale",
        "finding_ids",
        "missing_evidence"
      ],
      "properties": {
        "id": {
          "enum": [
            "alternative-comparison",
            "contract-coherence",
            "error-and-validation-flow",
            "runtime-invariant-placement"
          ]
        },
        "lenses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "status": {
          "enum": ["clear", "candidate", "unknown", "not-applicable"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"}
        },
        "missing_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MC-[0-9]+$"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "candidate"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"finding_ids": {"minItems": 1}}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "unknown"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"missing_evidence": {"minItems": 1}}
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "confirmed", "refuted", "applied", "blocked"],
      "properties": {
        "candidates": {"type": "integer", "minimum": 0},
        "confirmed": {"type": "integer", "minimum": 0},
        "refuted": {"type": "integer", "minimum": 0},
        "applied": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "implementation"}},
        "required": ["mode"]
      },
      "then": {
        "required": ["profile", "scope", "test_review_mode", "test_evidence", "disposition"]
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {"mode": {"const": "multi-agent-incomplete"}},
            "required": ["mode"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "minimum_independent_reviewers_met": {"const": false},
              "fallback_reason": {"type": "string", "minLength": 1}
            }
          },
          "gate_status": {"const": "blocked"}
        }
      }
    },
    {
      "if": {
        "properties": {"scope": {"const": "tests"}},
        "required": ["scope"]
      },
      "then": {
        "properties": {"mode": {"const": "implementation"}},
        "required": ["mode", "test_review_mode", "test_evidence"]
      }
    },
    {
      "if": {
        "properties": {"test_review_mode": {"const": "authoring"}},
        "required": ["test_review_mode"]
      },
      "then": {
        "required": ["test_authoring_gates"]
      }
    },
    {
      "if": {
        "properties": {"test_review_mode": {"enum": ["audit", "campaign"]}},
        "required": ["test_review_mode"]
      },
      "then": {
        "required": ["test_audit_candidates"]
      }
    },
    {
      "if": {
        "properties": {"test_review_mode": {"const": "campaign"}},
        "required": ["test_review_mode"]
      },
      "then": {
        "properties": {
          "test_audit_candidates": {"minItems": 1}
        },
        "required": ["test_campaign"]
      }
    },
    {
      "if": {
        "properties": {"disposition": {"const": "report-only"}},
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "mode": {"const": "implementation"},
          "applied_fixes": {
            "items": {
              "properties": {"status": {"const": "not-applicable"}},
              "required": ["status"]
            }
          },
          "summary": {
            "properties": {"applied": {"const": 0}},
            "required": ["applied"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"profile": {"const": "maintainability"}},
        "required": ["profile"]
      },
      "then": {
        "properties": {"mode": {"const": "implementation"}},
        "required": [
          "mode",
          "maintainability_inspections",
          "analysis_tool_evidence",
          "maintainability_candidates"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profile": {"const": "maintainability"},
          "gate_status": {"const": "pass"}
        },
        "required": ["profile", "gate_status"]
      },
      "then": {
        "properties": {
          "maintainability_inspections": {
            "items": {
              "properties": {
                "status": {"enum": ["clear", "candidate", "not-applicable"]}
              }
            }
          }
        },
        "required": ["maintainability_inspections"]
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {"mode": {"const": "multi-agent"}},
            "required": ["mode"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "workers": {
                "minItems": 2,
                "contains": {
                  "properties": {"role": {"const": "reviewer"}},
                  "required": ["role"]
                },
                "minContains": 2
              },
              "minimum_independent_reviewers_met": {"const": true},
              "fallback_reason": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {"mode": {"const": "degraded-sequential"}},
            "required": ["mode"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "minimum_independent_reviewers_met": {"const": false},
              "fallback_reason": {"type": "string", "minLength": 1}
            }
          },
          "gate_status": {"const": "degraded"}
        }
      }
    }
  ]
}
