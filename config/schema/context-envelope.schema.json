{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagi-labs/agentctl/config/schema/context-envelope.schema.json",
  "title": "agentctl context envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "phase", "status", "trigger", "workspace",
    "artifacts", "authority", "capabilities", "routing", "budget",
    "recent_event_ids", "approval"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "phase": {"type": "string"},
    "status": {"enum": ["ready", "waiting_for_approval", "blocked"]},
    "trigger": {"$ref": "#/$defs/trigger"},
    "workspace": {"$ref": "#/$defs/workspace"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "authority": {"type": "string"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "routing": {"$ref": "#/$defs/routing"},
    "budget": {"$ref": "#/$defs/budget"},
    "recent_event_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "maxLength": 256}
    },
    "approval": {"$ref": "#/$defs/approval"}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "source", "type"],
      "properties": {
        "event_id": {"type": "string"},
        "source": {"type": "string"},
        "type": {"type": "string"}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "root", "branch", "worktree"],
      "properties": {
        "repository": {"type": "string"},
        "root": {"$ref": "#/$defs/nullableString"},
        "branch": {"$ref": "#/$defs/nullableString"},
        "worktree": {"$ref": "#/$defs/nullableString"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "decision", "plan", "contract", "handoff", "progress", "review"],
      "properties": {
        "definition": {"$ref": "#/$defs/nullableString"},
        "decision": {"$ref": "#/$defs/nullableString"},
        "plan": {"$ref": "#/$defs/nullableString"},
        "contract": {"$ref": "#/$defs/nullableString"},
        "handoff": {"$ref": "#/$defs/nullableString"},
        "progress": {"$ref": "#/$defs/nullableString"},
        "review": {"$ref": "#/$defs/nullableString"}
      }
    },
    "capabilityList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional", "forbidden", "available", "missing", "status"],
      "properties": {
        "required": {"$ref": "#/$defs/capabilityList"},
        "optional": {"$ref": "#/$defs/capabilityList"},
        "forbidden": {"$ref": "#/$defs/capabilityList"},
        "available": {"$ref": "#/$defs/capabilityList"},
        "missing": {"$ref": "#/$defs/capabilityList"},
        "status": {"enum": ["unresolved", "satisfied", "blocked"]}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "runner"],
      "properties": {
        "strategy": {"type": "string"},
        "runner": {"type": ["string", "null"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_passes", "max_duration_seconds", "max_cost"],
      "properties": {
        "max_passes": {"type": "integer", "minimum": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_cost": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "pending", "approved", "rejected"]}
      }
    }
  }
}
