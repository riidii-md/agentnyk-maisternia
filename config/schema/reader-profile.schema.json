{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentnyk-maisternia.local/schema/reader-profile.schema.json",
  "title": "Reader adaptation profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "defaults", "situations"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "defaults": {
      "$ref": "#/$defs/preferences"
    },
    "situations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/situation"
      },
      "maxItems": 64
    }
  },
  "$defs": {
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["auto", "scan", "decide", "learn", "operate", "reference", "narrative"]
        },
        "density": {
          "enum": ["compact", "balanced", "detailed"]
        },
        "answer_position": {
          "enum": ["auto", "first", "contextual"]
        },
        "terminology": {
          "enum": ["plain", "dual-label", "domain-native"]
        },
        "visuals": {
          "enum": ["auto", "prefer", "avoid"]
        },
        "evidence": {
          "enum": ["inline", "near-claim", "appendix"]
        },
        "interaction": {
          "enum": ["ask-when-material", "infer-and-state", "never-ask"]
        },
        "layering": {
          "type": "boolean"
        },
        "first_pass_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "overrides"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "when": {
          "$ref": "#/$defs/match"
        },
        "overrides": {
          "$ref": "#/$defs/preferences"
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "task": {
          "enum": ["scan", "decide", "learn", "operate", "reference", "narrative"]
        },
        "medium": {
          "enum": ["chat", "terminal", "markdown", "html", "document", "slides", "email"]
        },
        "audience": {
          "enum": ["novice", "mixed", "expert"]
        }
      }
    }
  }
}
