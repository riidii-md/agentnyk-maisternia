{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagi-labs/agentnyk-maisternia/config/schema/preset.schema.json",
  "title": "AgentnykMaisternia preset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "description", "pipelines", "contents",
    "targets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 2048},
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}/[a-z][a-z0-9-]{0,63}$"
      }
    },
    "pipelines": {
      "type": "array",
      "items": {"$ref": "#/$defs/pipeline"}
    },
    "contents": {"$ref": "#/$defs/contents"},
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["codex", "claude", "antigravity", "hermes"]
      }
    },
    "environment_packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    }
  },
  "$defs": {
    "resourceList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      }
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp_refs", "commands", "prompts", "skills", "hooks", "settings"
      ],
      "properties": {
        "mcp_refs": {"$ref": "#/$defs/resourceList"},
        "commands": {"$ref": "#/$defs/resourceList"},
        "prompts": {"$ref": "#/$defs/resourceList"},
        "skills": {"$ref": "#/$defs/resourceList"},
        "hooks": {"$ref": "#/$defs/resourceList"},
        "settings": {"$ref": "#/$defs/resourceList"}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "entry_phases", "phases", "edges"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "entry_phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "condition": {"type": "string", "maxLength": 256},
        "loop": {"type": "boolean"}
      }
    }
  }
}
