{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagi-labs/agentnyk-maisternia/config/schema/collection.schema.json",
  "title": "AgentnykMaisternia preset collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "match"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 2048},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_tags"],
      "properties": {
        "all_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}/[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    }
  }
}
