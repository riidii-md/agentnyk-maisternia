{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagi-labs/agentnyk-maisternia/config/schema/environment-pack.schema.json",
  "title": "AgentnykMaisternia environment pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "minLength": 1, "maxLength": 2048},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["darwin", "linux", "windows"]}
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "plugin_id": {"$ref": "#/$defs/id"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "kind", "required", "provides",
        "depends_on", "detect", "installers"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "kind": {"enum": ["binary", "host-plugin"]},
        "required": {"type": "boolean"},
        "provides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "detect": {"$ref": "#/$defs/detection"},
        "installers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/installer"}
        }
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "platforms"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "homebrew", "go-install", "cargo-binstall", "npm-global",
            "host-plugin", "manual"
          ]
        },
        "platforms": {"$ref": "#/$defs/platforms"},
        "package": {"type": "string"},
        "tap": {"type": "string"},
        "module": {"type": "string"},
        "version": {"type": "string"},
        "crate": {"type": "string"},
        "host": {"type": "string"},
        "repository": {"type": "string"},
        "ref": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 2048}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "homebrew"}}},
          "then": {"required": ["package"]}
        },
        {
          "if": {"properties": {"kind": {"const": "go-install"}}},
          "then": {"required": ["module", "version"]}
        },
        {
          "if": {"properties": {"kind": {"const": "cargo-binstall"}}},
          "then": {"required": ["crate", "version"]}
        },
        {
          "if": {"properties": {"kind": {"const": "npm-global"}}},
          "then": {"required": ["package", "version"]}
        },
        {
          "if": {"properties": {"kind": {"const": "host-plugin"}}},
          "then": {"required": ["host", "repository", "ref"]}
        },
        {
          "if": {"properties": {"kind": {"const": "manual"}}},
          "then": {"required": ["url", "instructions"]}
        }
      ]
    }
  }
}
