{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagi-labs/agentctl/config/schema/task-state.schema.json",
  "title": "agentctl durable task state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "title", "repository", "subject_kind",
    "subject_id", "phase", "status", "next_action", "authority", "approval",
    "trigger", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "title": {"type": "string", "maxLength": 512},
    "repository": {"type": "string", "maxLength": 256},
    "subject_kind": {"type": "string"},
    "subject_id": {"type": "string"},
    "phase": {"type": "string"},
    "status": {"enum": ["ready", "waiting_for_approval", "blocked"]},
    "next_action": {"type": "string"},
    "authority": {"type": "string"},
    "approval": {"$ref": "context-envelope.schema.json#/$defs/approval"},
    "trigger": {"$ref": "context-envelope.schema.json#/$defs/trigger"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
