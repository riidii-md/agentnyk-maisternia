{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kagi-labs/agentctl/config/schema/shape-source.schema.json",
  "title": "agentctl shape source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_id", "task_id", "kind", "trust", "status",
    "materiality", "added_by", "added_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "pattern": "^src-[a-f0-9]{16}$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "kind": {"enum": ["url", "file", "note"]},
    "location": {"type": "string", "maxLength": 4096},
    "note": {"type": "string", "maxLength": 16384},
    "trust": {"enum": ["untrusted", "user_provided"]},
    "status": {"enum": ["unread", "reviewed", "incorporated", "rejected"]},
    "materiality": {
      "enum": [
        "unclassified", "supporting", "contextual", "contradictory",
        "requirement-changing", "irrelevant", "unsafe"
      ]
    },
    "added_by": {"type": "string", "maxLength": 128},
    "added_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
