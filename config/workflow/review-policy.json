{
  "schema_version": 1,
  "max_parallel_reviewers": 8,
  "execution": {
    "strategy": "bounded-parallel-waves",
    "native_subagents": "required-when-supported",
    "minimum_independent_reviewers": 3,
    "scoped_minimums": {
      "full": 3,
      "tests": 2,
      "plan": 3,
      "direction": 3
    },
    "lane_isolation_required": true,
    "coordinator_may_review": false,
    "sequential_fallback": "explicit-opt-in",
    "degraded_flag": "--allow-degraded",
    "spawn_failure": "blocked-without-degraded-opt-in",
    "full_gate_requires_multi_agent": true,
    "wave_limit": "minimum-of-policy-and-harness-capacity"
  },
  "modes": ["direction", "plan", "plan-delta", "implementation"],
  "dispositions": ["repair", "report-only"],
  "scopes": ["full", "tests"],
  "implementation_lenses": [
    "correctness",
    "consistency",
    "completeness-edge-cases",
    "security",
    "architecture",
    "simplicity-dry",
    "diff-analysis",
    "dependency-currency",
    "test-review-bundle"
  ],
  "plan_lenses": [
    "correctness-vs-code",
    "internal-consistency",
    "completeness-edge-cases",
    "architecture-simplicity",
    "best-practices",
    "acceptance-testability"
  ],
  "profiles": {
    "maintainability": {
      "applies_to": ["implementation"],
      "uses_lenses": "implementation_lenses",
      "additional_lenses": ["best-practices"],
      "focus_lenses": [
        "correctness",
        "consistency",
        "architecture",
        "simplicity-dry",
        "test-review-bundle"
      ],
      "goals": [
        "preserve-observable-behavior",
        "reduce-knowledge-duplication",
        "improve-abstraction-boundaries",
        "remove-unnecessary-complexity",
        "follow-grounded-best-practices"
      ],
      "selection_rule": "stop-at-first-behavior-preserving-fit",
      "selection_ladder": [
        "apply-yagni",
        "reuse-existing",
        "use-standard-library",
        "use-native-platform",
        "use-installed-dependency",
        "use-direct-control-flow",
        "introduce-abstraction-last"
      ],
      "simplification_kinds": [
        "delete",
        "reuse",
        "stdlib",
        "native",
        "dependency",
        "yagni",
        "shrink"
      ],
      "candidate_requirements": [
        "behavior-contract",
        "concrete-evidence",
        "minimal-fix",
        "net-simplification",
        "regression-risk",
        "verification-plan",
        "simplification-kind-when-applicable"
      ],
      "guardrails": [
        "no-functional-regressions",
        "no-incidental-dry",
        "no-speculative-abstractions",
        "no-style-only-findings",
        "no-line-count-only-decisions"
      ],
      "comment_policy": {
        "selection_rule": "preserve-irreducible-rationale",
        "keep_when": [
          "non-obvious-local-rationale",
          "invariants-and-trust-boundaries",
          "compatibility-or-safety-constraints",
          "deliberate-limitations-and-upgrade-paths"
        ],
        "simplify_by": [
          "prefer-names-types-tests-assertions-or-structure",
          "shorten-to-constraint-and-consequence",
          "move-cross-cutting-decisions-to-durable-documentation",
          "leave-a-local-pointer-when-discoverability-matters"
        ],
        "remove_when": [
          "code-narration",
          "stale-or-contradictory-comments",
          "commented-out-code",
          "speculative-future-guidance",
          "duplicated-decision-history"
        ],
        "finding_kinds": {
          "delete": "redundant-stale-or-commented-out-code",
          "shrink": "useful-but-verbose-local-rationale",
          "reuse": "centralize-cross-cutting-or-duplicated-rationale",
          "yagni": "speculative-future-guidance"
        },
        "guardrails": [
          "no-comment-volume-or-line-count-only-decisions",
          "no-removal-of-security-validation-accessibility-data-loss-or-compatibility-rationale-without-durable-equivalent"
        ]
      },
      "context_discovery": {
        "strategy": "evidence-led-heuristic",
        "language_agnostic": true,
        "multi_language": true,
        "sources": [
          "repository-instructions",
          "ci-and-hooks",
          "build-and-package-manifests",
          "lockfiles",
          "source-and-generated-file-markers",
          "changed-paths"
        ],
        "outcomes": ["detected", "mixed", "unknown"],
        "rules": [
          "record-evidence-and-confidence",
          "prefer-repository-owned-commands",
          "no-extension-only-inference",
          "no-unapproved-tool-installation",
          "preserve-unknowns"
        ]
      },
      "analysis_tools": {
        "requirements": ["disabled", "advisory", "required"],
        "default_mode": "advisory",
        "statuses": ["complete", "partial", "unavailable", "failed", "stale"],
        "snapshot_reuse": {
          "immutable": true,
          "once_per_pass": true,
          "invalidate_after_repair": true
        },
        "budgets": {
          "max_candidate_families": 30,
          "max_locations_per_family": 8,
          "max_excerpt_bytes": 4096,
          "gitnexus_max_traversal_depth": 2,
          "timeout_seconds": 120
        },
        "jscpd": {
          "requirement": "advisory",
          "executable": "jscpd",
          "approved_version": "5.3.2",
          "configuration": ["repository-owned", "task-owned-generated"],
          "language_scope": "discovered-repository-supported",
          "exclusions": [
            "repository-rules",
            "gitignore",
            "confirmed-generated",
            "confirmed-vendored",
            "cache-and-build-output",
            "minified-files",
            "snapshots"
          ],
          "passes": [
            "exact",
            "normalized",
            "near-miss-gap",
            "near-miss-ast",
            "complexity",
            "dead-code"
          ],
          "near_miss_default": "disabled",
          "complexity_default": "enabled-when-supported",
          "dead_code_default": "enabled-when-supported",
          "base_ref": "resolved-review-base",
          "artifact": "evidence/jscpd",
          "rules": [
            "verify-exact-version-before-analysis",
            "prefer-repository-owned-config",
            "generate-fallback-config-only-under-review-artifacts",
            "respect-gitignore-and-confirmed-exclusions",
            "do-not-exclude-tests-by-category",
            "json-is-deterministic-ingestion-source",
            "ai-output-is-bounded-diagnostics-only",
            "distinguish-zero-files-from-zero-candidates",
            "no-threshold-or-health-score-gate",
            "no-install-upgrade-network-or-repository-code-execution"
          ]
        },
        "gitnexus": {
          "requirement": "advisory",
          "reuse": "existing-repository-bounded-index",
          "relationships": [
            "symbols",
            "callers-callees",
            "imports-dependencies",
            "inheritance-implementations",
            "processes-routes",
            "related-tests",
            "related-implementations",
            "change-impact"
          ],
          "rules": [
            "record-repository-identity-and-snapshot",
            "record-index-freshness-and-capabilities",
            "bound-transitive-traversal",
            "prefer-stable-symbol-identities",
            "preserve-ambiguous-unresolved-and-excluded-surfaces",
            "missing-edge-is-not-proof-of-absence",
            "no-second-graph-or-index",
            "no-unapproved-refresh-network-or-repository-code-execution"
          ]
        },
        "failure_behavior": {
          "advisory": "record-and-continue",
          "required": "mark-unknown-and-block",
          "zero_applicable_files": "record-distinct-from-zero-candidates"
        }
      },
      "inspection_statuses": [
        "clear",
        "candidate",
        "unknown",
        "not-applicable"
      ],
      "inspection_completion": {
        "required_for_profile": true,
        "unknown_prevents_pass": true,
        "no_findings_requires_proof": true
      },
      "inspection_obligations": [
        {
          "id": "alternative-comparison",
          "lenses": ["simplicity-dry"],
          "inspect": [
            "concrete-simpler-alternative",
            "introduced-concepts-state-branches-and-layers",
            "forwarding-wrappers-and-consumer-count",
            "behavior-and-safeguards-preserved"
          ]
        },
        {
          "id": "contract-coherence",
          "lenses": ["consistency", "architecture"],
          "inspect": [
            "base-implementation-and-caller-contracts",
            "nullability-and-reachable-absence",
            "type-shape-and-alias-burden",
            "generic-boundary-domain-leakage"
          ]
        },
        {
          "id": "error-and-validation-flow",
          "lenses": ["correctness", "architecture"],
          "inspect": [
            "representative-success-and-failure-flow",
            "validation-conversion-and-error-translation-hops",
            "distinct-error-recovery-behavior",
            "exception-and-error-ownership"
          ]
        },
        {
          "id": "runtime-invariant-placement",
          "lenses": ["correctness"],
          "inspect": [
            "runtime-input-failure-versus-developer-invariant",
            "value-origin-and-reachability",
            "repeated-hot-path-contract-checks",
            "failure-semantics-after-simplification"
          ]
        }
      ]
    }
  },
  "test_review": {
    "scope": "tests",
    "applies_to": ["implementation"],
    "embedded_in_full_implementation_review": true,
    "standalone_command": "work-test-review",
    "modes": ["review", "authoring", "audit", "campaign"],
    "lenses": [
      "intent-oracle",
      "risk-edge-coverage",
      "level-fidelity",
      "economy-maintainability"
    ],
    "matrix_fields": [
      "contract_or_risk",
      "source",
      "test_level",
      "scenario",
      "oracle",
      "evidence",
      "distinct_value",
      "residual_risk",
      "status"
    ],
    "statuses": ["covered", "partial", "missing", "accepted-risk"],
    "metrics_role": "supporting-evidence",
    "authoring_gate": {
      "questions": [
        "observable-contract",
        "credible-regression",
        "existing-coverage-gap",
        "production-seam"
      ],
      "bug_regression_control": "fail-before-pass-after-for-intended-reason"
    },
    "audit": {
      "primary_owner_rule": "one-primary-owner-at-cheapest-faithful-boundary",
      "candidate_fields": [
        "test",
        "disposition",
        "detected_failure",
        "primary_owner",
        "non_test_callers",
        "surviving_proof",
        "history",
        "unlocked_deletions",
        "risk",
        "validation"
      ],
      "dispositions": ["retain", "fix", "consolidate", "delete"],
      "junk_patterns": [
        "assertion-free-probe",
        "self-comparison-or-derived-expected-value",
        "copied-inventory-manifest-or-export-list",
        "source-import-or-string-grep-without-independent-contract",
        "private-predicate-or-call-shape-replay",
        "duplicate-contract-invocation",
        "test-only-production-seam-or-dead-code",
        "mock-implements-asserted-behavior",
        "negative-control-passes-for-unrelated-reason",
        "name-or-fixture-overstates-exercised-behavior"
      ],
      "retention_rules": [
        "retain-independent-public-or-cross-system-contracts",
        "retain-observable-ordering-and-credible-regressions",
        "retain-static-inspection-when-cheapest-independent-guard",
        "investigate-baseline-failures-as-possible-product-defects",
        "never-delete-for-slowness-or-implementation-resemblance-alone"
      ]
    },
    "campaign": {
      "scope": "one-subsystem",
      "steps": [
        "baseline",
        "owner-lanes",
        "declaration-ledger",
        "layer-plan",
        "cutover",
        "preservation-review",
        "product-defects",
        "reconcile-handoff"
      ],
      "mutation_control": "required-for-restored-contracts"
    },
    "rules": [
      "ground-in-accepted-behavior-not-implementation-alone",
      "choose-cheapest-faithful-test-level",
      "prefer-observable-state-over-private-interactions",
      "cover-material-boundaries-failures-and-recovery",
      "require-distinct-confidence-or-diagnostic-value",
      "preserve-damp-readability-over-incidental-dry",
      "treat-coverage-fuzzing-and-mutation-as-contextual-evidence",
      "use-synthetic-credential-free-fixtures",
      "no-test-count-line-count-or-percentage-only-findings"
    ]
  },
  "domain_lenses": {
    "accessibility": "user interface or user interaction changes",
    "privacy-pii-soc2": "personal, sensitive, regulated, audit, or access-control data",
    "performance-scalability": "latency, throughput, memory, storage, or concurrency risk",
    "migration-safety": "schema, data, protocol, dependency, rollout, or compatibility changes"
  },
  "evidence": {
    "required": true,
    "accepted": ["file-line", "verbatim-quote", "test", "command", "authoritative-document"],
    "actual_code_required": true
  },
  "verification": {
    "one_verifier_per_candidate": true,
    "verifier_must_attempt_refutation": true,
    "verifier_must_use_different_worker": true,
    "keep_only_when": ["is_real", "grounded"],
    "deduplicate_after_verification": true
  },
  "application": {
    "reviewers_are_read_only": true,
    "repair": {
      "coordinator_applies_fixes": true,
      "apply_all_confirmed": true,
      "critical_high_blocking": true,
      "rerun_affected_checks": true,
      "unresolved_requires_gate_failure": true
    },
    "report_only": {
      "coordinator_edits_reviewed_artifact": false,
      "confirmed_fix_status": "not-applicable",
      "pass_means_review_complete_not_implementation_approved": true
    }
  },
  "delegation": {
    "routing_contract": "work-routing",
    "native_subagents_required_when_supported": true,
    "cross_provider_strategy": "parallel-verify",
    "prefer_different_provider_for_verification": true,
    "delegates_read_only": true,
    "coordinator_owns_fixes": true
  },
  "artifacts": {
    "directory": ".agent-runs/reviews/<run-id>",
    "markdown": "review.md",
    "json": "review.json"
  }
}
